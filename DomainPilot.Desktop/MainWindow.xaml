<Window x:Class="DomainPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DomainPilot RSAT Console" Height="900" Width="1420" MinHeight="760" MinWidth="1180"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#126E82"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="24">
                    <TextBlock Text="DomainPilot" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="RSAT Console" Foreground="#A7F3D0" FontSize="14" Margin="0,4,0,0"/>
                    <Border Height="1" Background="#2A3548" Margin="0,22,0,18"/>
                    <TextBlock Text="Safety Mode" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SafetyMode}" Foreground="#A7F3D0" TextWrapping="Wrap" Margin="0,6,0,18"/>
                    <TextBlock Text="Operator" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OperatorName}" Foreground="#E2E8F0" Margin="0,6,0,18"/>
                    <TextBlock Text="Project" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <TextBlock Text="github.com/buffaskunk" Foreground="#E2E8F0" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="24">
                    <TextBlock Text="Prototype Guardrails" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <TextBlock Text="Validation first. Script preview second. Live execution only after explicit environment configuration." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Active Directory Operations Workspace" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Bulk user creation, policy readiness, device lookup, script planning, and audit logging for help desk technicians." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,6,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#E7F7F3" BorderBrush="#9DEBD9" BorderThickness="1" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#12B76A" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding EnvironmentStatus}" FontWeight="SemiBold" Foreground="#05603A"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <TabControl Grid.Row="1" Background="Transparent">
                <TabItem Header="Dashboard">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.ColumnSpan="2" Rows="1" Columns="4" Margin="0,0,0,18">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Queued Users" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding QueuedUserCount}" FontSize="30" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Valid Rows" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ValidUserCount}" FontSize="30" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Managed Devices" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding ManagedDeviceCount}" FontSize="30" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Audit Events" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding AuditEventCount}" FontSize="30" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="0,0,18,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Environment Readiness" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding SetupChecks}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="150"/>
                                        <DataGridTextColumn Header="Check" Binding="{Binding Requirement}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTextColumn Header="Why it matters" Binding="{Binding HelpText}" Width="260"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Technician Training Notes" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding TrainingGuide, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" BorderThickness="0" Background="#F8FAFC" Padding="14" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Bulk Users">
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="1.2*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Import CSV" Click="ImportUsers_Click"/>
                            <Button Content="Load Example" Click="LoadSampleUsers_Click" Background="#475467"/>
                            <Button Content="Validate Rows" Click="ValidateBulkUsers_Click"/>
                            <Button Content="Generate PowerShell Plan" Click="GenerateBulkScript_Click"/>
                            <Button Content="Export Review Report" Click="ExportValidationReport_Click" Background="#475467"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ImportSummary}" Foreground="#175CD3" TextWrapping="Wrap"/>
                        </Border>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding BulkUsers}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CSV Row" Binding="{Binding SourceLine}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ValidationStatus}" Width="100"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding SamAccountName}" Width="120"/>
                                <DataGridTextColumn Header="First" Binding="{Binding FirstName}" Width="120"/>
                                <DataGridTextColumn Header="Last" Binding="{Binding LastName}" Width="120"/>
                                <DataGridTextColumn Header="OU" Binding="{Binding OrganizationalUnit}" Width="250"/>
                                <DataGridTextColumn Header="Groups" Binding="{Binding Groups}" Width="220"/>
                                <DataGridTextColumn Header="Profile Path" Binding="{Binding ProfilePath}" Width="240"/>
                                <DataGridTextColumn Header="Allowed PCs" Binding="{Binding AllowedWorkstations}" Width="180"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding ValidationMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Generated Script Preview" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                <TextBox x:Name="ScriptPreviewBox" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" AcceptsReturn="True" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="User &amp; Device Lookup">
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBox x:Name="LookupTextBox" Width="360" Padding="10" FontSize="15" Text="jmartinez" VerticalContentAlignment="Center"/>
                            <Button Content="Lookup User" Click="LookupUser_Click" Margin="8,0,0,0"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="0,0,18,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Last Sign-in Sessions" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <DataGrid ItemsSource="{Binding DeviceSessions}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                                            <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="150"/>
                                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="140"/>
                                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="170"/>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Remote Support Context" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding LookupSummary}" FontSize="15" TextWrapping="Wrap"/>
                                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" Padding="14" Margin="0,18,0,0">
                                        <TextBlock Text="Production design note: last-PC lookup should come from domain controller security events, endpoint agent telemetry, or approved SIEM logs. DomainPilot keeps that source explicit so technicians know what they are trusting." TextWrapping="Wrap" Foreground="#9A3412"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Scripts &amp; Actions">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="0,0,18,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Approved Action Catalog" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding ActionTemplates}" SelectionChanged="ActionTemplates_SelectionChanged" x:Name="ActionTemplateGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Name}" Width="190"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="90"/>
                                        <DataGridTextColumn Header="Requires" Binding="{Binding RequiredRole}" Width="160"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Action Preview" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBox x:Name="ActionPreviewBox" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Logs">
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Simulate Windows Log Scan" Click="ScanWindowsLogs_Click"/>
                            <Button Content="Export Audit Log" Click="ExportAuditLog_Click" Background="#475467"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AuditEvents}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="170"/>
                                <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="140"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="220"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
        </Grid>
    </Grid>
</Window>
